#!/usr/bin/env bash
# ==========================================
# secdev: Git Pre-Commit Security & Hygiene Hook
# ==========================================

echo "[secdev-hook] Running pre-commit validation..."

# 1. Block large model files (> 40MB) from ever being accidentally committed
LARGE_FILES=$(git diff --cached --name-only | while read -r file; do
    if [ -f "$file" ]; then
        size=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null)
        if [ "$size" -gt 41943040 ]; then
            echo "$file ($(($size / 1048576)) MB)"
        fi
    fi
done)

if [ -n "$LARGE_FILES" ]; then
    echo "ERROR: Attempting to commit large files directly into git repository:"
    echo "$LARGE_FILES"
    echo "Please use 'scripts/pull-model.ps1' or git-lfs for AI model weights."
    exit 1
fi

# 2. Block potential secret files
SUSPICIOUS=$(git diff --cached --name-only | grep -E '\.(pem|key|pfx|env)$')
if [ -n "$SUSPICIOUS" ]; then
    echo "ERROR: Attempting to commit potential secret/private key files:"
    echo "$SUSPICIOUS"
    exit 1
fi

echo "[secdev-hook] Pre-commit checks passed successfully."
exit 0
