<Application x:Class="Secdev.Workstation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Palette Colors -->
        <Color x:Key="ColorObsidian">#070a0f</Color>
        <Color x:Key="ColorSurface">#0d1117</Color>
        <Color x:Key="ColorPanel">#161b22</Color>
        <Color x:Key="ColorBorder">#30363d</Color>
        <Color x:Key="ColorNeonGreen">#00ff9d</Color>
        <Color x:Key="ColorCyberCyan">#00e5ff</Color>
        <Color x:Key="ColorAmber">#d29922</Color>
        <Color x:Key="ColorRed">#f85149</Color>
        <Color x:Key="ColorText">#f0f6fc</Color>
        <Color x:Key="ColorTextMuted">#8b949e</Color>

        <!-- Solid Color Brushes -->
        <SolidColorBrush x:Key="BrushObsidian" Color="{StaticResource ColorObsidian}"/>
        <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
        <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource ColorPanel}"/>
        <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
        <SolidColorBrush x:Key="BrushNeonGreen" Color="{StaticResource ColorNeonGreen}"/>
        <SolidColorBrush x:Key="BrushCyberCyan" Color="{StaticResource ColorCyberCyan}"/>
        <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource ColorAmber}"/>
        <SolidColorBrush x:Key="BrushRed" Color="{StaticResource ColorRed}"/>
        <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>

        <!-- Custom ScrollBar Theme -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="{StaticResource BrushObsidian}"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Cyber Button Style -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#1f242c"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, Courier New"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushNeonGreen}"/>
                                <Setter TargetName="border" Property="Background" Value="#252f38"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushNeonGreen}"/>
                                <Setter Property="Foreground" Value="#050505"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neon Action Button Style -->
        <Style x:Key="NeonActionButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Background" Value="#00ff9d"/>
            <Setter Property="Foreground" Value="#050505"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Application.Resources>
</Application>
