<Application x:Class="Secdev.Workstation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Serious Architectural Dark Engineering Palette (Muted, Refined, Non-Saturated) -->
        <Color x:Key="ColorBgRoot">#0b0e14</Color>
        <Color x:Key="ColorBgHeader">#0f131a</Color>
        <Color x:Key="ColorBgSidebar">#0f131a</Color>
        <Color x:Key="ColorBgDrawer">#11161e</Color>
        <Color x:Key="ColorBgPane">#0d1117</Color>
        <Color x:Key="ColorBgSectionHeader">#131820</Color>
        <Color x:Key="ColorBgCard">#141a23</Color>
        <Color x:Key="ColorBgElevated">#19202b</Color>

        <Color x:Key="ColorBorderSubtle">#212832</Color>
        <Color x:Key="ColorBorderStrong">#2c3543</Color>
        <Color x:Key="ColorBorderActive">#388bfd</Color>

        <!-- Refined Professional Accents & Diff Colors -->
        <Color x:Key="ColorAccentBlue">#4493f8</Color>
        <Color x:Key="ColorAccentSage">#3fb950</Color>
        <Color x:Key="ColorDiffAddedBg">#13261e</Color>
        <Color x:Key="ColorDiffAddedBar">#2ea043</Color>
        <Color x:Key="ColorDiffRemovedBg">#2c1519</Color>
        <Color x:Key="ColorDiffRemovedBar">#e5534b</Color>
        <Color x:Key="ColorWarningMuted">#d29922</Color>

        <!-- Typography Colors -->
        <Color x:Key="ColorTextPrimary">#e6edf3</Color>
        <Color x:Key="ColorTextSecondary">#8b949e</Color>
        <Color x:Key="ColorTextMuted">#545d68</Color>

        <!-- SolidColorBrushes -->
        <SolidColorBrush x:Key="BrushBgRoot" Color="{StaticResource ColorBgRoot}"/>
        <SolidColorBrush x:Key="BrushBgHeader" Color="{StaticResource ColorBgHeader}"/>
        <SolidColorBrush x:Key="BrushBgSidebar" Color="{StaticResource ColorBgSidebar}"/>
        <SolidColorBrush x:Key="BrushBgDrawer" Color="{StaticResource ColorBgDrawer}"/>
        <SolidColorBrush x:Key="BrushBgPane" Color="{StaticResource ColorBgPane}"/>
        <SolidColorBrush x:Key="BrushBgSectionHeader" Color="{StaticResource ColorBgSectionHeader}"/>
        <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}"/>
        <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}"/>

        <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}"/>
        <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}"/>
        <SolidColorBrush x:Key="BrushBorderActive" Color="{StaticResource ColorBorderActive}"/>

        <SolidColorBrush x:Key="BrushAccentBlue" Color="{StaticResource ColorAccentBlue}"/>
        <SolidColorBrush x:Key="BrushAccentSage" Color="{StaticResource ColorAccentSage}"/>
        <SolidColorBrush x:Key="BrushDiffAddedBg" Color="{StaticResource ColorDiffAddedBg}"/>
        <SolidColorBrush x:Key="BrushDiffAddedBar" Color="{StaticResource ColorDiffAddedBar}"/>
        <SolidColorBrush x:Key="BrushDiffRemovedBg" Color="{StaticResource ColorDiffRemovedBg}"/>
        <SolidColorBrush x:Key="BrushDiffRemovedBar" Color="{StaticResource ColorDiffRemovedBar}"/>
        <SolidColorBrush x:Key="BrushWarningMuted" Color="{StaticResource ColorWarningMuted}"/>

        <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>

        <!-- Architectural Minimalist ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#28313e" CornerRadius="3" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Rail Icon Button -->
        <Style x:Key="SidebarIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#18202b"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#1d2633"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Toolbar Action Button -->
        <Style x:Key="ToolbarMiniBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="Arial, Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#1a222d"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#2c3646"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
