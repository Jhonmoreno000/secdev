<Window x:Class="Secdev.Workstation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="secdev — Estación de Ingeniería de Software y Ciberseguridad con IA Local"
        Height="900" Width="1500"
        MinHeight="480" MinWidth="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged"
        KeyDown="Window_KeyDown">

    <Grid>
        <!-- Marco Arquitectónico Principal -->
        <Border x:Name="OuterBorder"
                Background="{StaticResource BrushBgRoot}"
                BorderBrush="{StaticResource BrushBorderStrong}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/> <!-- Fila 0: Barra Superior de Navegación y Control -->
                    <RowDefinition Height="*"/>  <!-- Fila 1: Área de Trabajo Principal -->
                    <RowDefinition Height="34"/> <!-- Fila 2: Barra de Telemetría de Hardware e Inferencia Local -->
                </Grid.RowDefinitions>

                <!-- ========================================================= -->
                <!-- FILA 0: Barra Superior de Navegación Arquitectónica       -->
                <!-- ========================================================= -->
                <Border Grid.Row="0"
                        Background="{StaticResource BrushBgHeader}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="14,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Identificador del Sistema -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrushAccentBlue}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="secdev"
                                       FontFamily="Arial"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock x:Name="TxtHeaderSubtitle"
                                       Text="  —  Estación de Ingeniería de Software y Ciberseguridad (IA Local + RAG)"
                                       FontFamily="Arial"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Acciones Rápidas de Proyecto, IA Local y Dimensiones -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button Content="[+] Subir Archivos" Style="{StaticResource ToolbarMiniBtn}" Click="BtnOpenExternalFile_Click" ToolTip="Subir o importar archivos de código fuente del usuario al espacio de trabajo"/>
                            <Button Content="[>] Abrir Proyecto" Style="{StaticResource ToolbarMiniBtn}" Click="BtnOpenFolder_Click" ToolTip="Seleccionar carpeta de proyecto local"/>
                            <Button Content="[Git] Clonar Repositorio" Style="{StaticResource ToolbarMiniBtn}" Click="BtnNavGit_Click" ToolTip="Clonar un repositorio Git remoto o gestionar control de cambios"/>
                            <Button Content="[ESP] Especialidades (12)" Style="{StaticResource ToolbarMiniBtn}" Click="BtnNavSkills_Click" ToolTip="Catálogo de especialidades técnicas e ISO para ahorro de tokens"/>

                            <Border Background="#141a23" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="6,0,6,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtDiffSummaryBadge"
                                           Text="+0  -0 líneas"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>
                            <Border Background="#141a23" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtResolutionBadge"
                                           Text="1500×900 [AMPLIO]"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>
                            <Button Content="C" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSizeSmall_Click" ToolTip="Formato Compacto (820×620)"/>
                            <Button Content="M" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSizeMedium_Click" ToolTip="Formato Estándar (1160×740)"/>
                            <Button Content="G" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSizeLarge_Click" ToolTip="Formato Estación Completa (1520×900)"/>
                        </StackPanel>

                        <!-- Controles de Ventana -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="—" Style="{StaticResource WindowControlBtn}" Click="BtnMinimize_Click" ToolTip="Minimizar ventana"/>
                            <Button x:Name="BtnMaxRestore" Content="[ ]" Style="{StaticResource WindowControlBtn}" Click="BtnMaximize_Click" ToolTip="Maximizar o restaurar ventana"/>
                            <Button Content="X" Style="{StaticResource WindowControlBtn}" Click="BtnClose_Click" ToolTip="Cerrar estación de trabajo"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- FILA 1: Cuerpo Principal de la Estación de Trabajo        -->
                <!-- ========================================================= -->
                <Grid Grid.Row="1" Margin="0,4,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>   <!-- Col 0: Barra Lateral de Actividad -->
                        <ColumnDefinition Width="Auto"/> <!-- Col 1: Panel Lateral Desplegable -->
                        <ColumnDefinition Width="*"/>    <!-- Col 2: Espacio de Trabajo Dividido -->
                    </Grid.ColumnDefinitions>

                    <!-- ===================================================== -->
                    <!-- COL 0: Barra Lateral de Navegación                    -->
                    <!-- ===================================================== -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BrushBgSidebar}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Iconos Superiores de Navegación Técnica -->
                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <!-- 1. Explorador de Archivos del Usuario -->
                                <Grid>
                                    <Border x:Name="IndExplorer" Width="2" Height="20" Background="{StaticResource BrushAccentBlue}" HorizontalAlignment="Left" Margin="-5,0,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnNavExplorer" Style="{StaticResource SidebarIconButton}" Click="BtnNavExplorer_Click" ToolTip="Explorador de Archivos del Usuario (Subir, Crear y Gestionar Archivos)">
                                        <TextBlock Text="DIR" FontSize="11" FontWeight="Bold" FontFamily="Arial"/>
                                    </Button>
                                </Grid>

                                <!-- 2. Búsqueda Léxica Global -->
                                <Grid>
                                    <Border x:Name="IndSearch" Width="2" Height="20" Background="{StaticResource BrushAccentBlue}" HorizontalAlignment="Left" Margin="-5,0,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnNavSearch" Style="{StaticResource SidebarIconButton}" Click="BtnNavSearch_Click" ToolTip="Búsqueda Léxica de Símbolos y Patrones en el Proyecto">
                                        <TextBlock Text="BUS" FontSize="11" FontWeight="Bold" FontFamily="Arial"/>
                                    </Button>
                                </Grid>

                                <!-- 3. Clonación Git y Control de Diferencias -->
                                <Grid>
                                    <Border x:Name="IndGit" Width="2" Height="20" Background="{StaticResource BrushAccentBlue}" HorizontalAlignment="Left" Margin="-5,0,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnNavGit" Style="{StaticResource SidebarIconButton}" Click="BtnNavGit_Click" ToolTip="Clonación de Repositorios Git y Control de Diferencias (Diff)">
                                        <TextBlock Text="GIT" FontSize="11" FontWeight="Bold" FontFamily="Arial"/>
                                    </Button>
                                </Grid>

                                <!-- 4. Catálogo de Especialidades de Ingeniería -->
                                <Grid>
                                    <Border x:Name="IndSkills" Width="2" Height="20" Background="{StaticResource BrushAccentBlue}" HorizontalAlignment="Left" Margin="-5,0,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnNavSkills" Style="{StaticResource SidebarIconButton}" Click="BtnNavSkills_Click" ToolTip="Catálogo de Especialidades de Ingeniería e ISO (Optimizador de Contexto)">
                                        <TextBlock Text="ESP" FontSize="11" FontWeight="Bold" FontFamily="Arial"/>
                                    </Button>
                                </Grid>

                                <!-- 5. Auditoría SAST y Calidad en Tiempo Real -->
                                <Grid>
                                    <Border x:Name="IndAudit" Width="2" Height="20" Background="{StaticResource BrushAccentBlue}" HorizontalAlignment="Left" Margin="-5,0,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnNavAudit" Style="{StaticResource SidebarIconButton}" Click="BtnNavAudit_Click" ToolTip="Ejecutar Auditoría Estática SAST (OWASP/CWE) y Evaluación ISO/IEC 25010">
                                        <TextBlock Text="SEC" FontSize="11" FontWeight="Bold" FontFamily="Arial"/>
                                    </Button>
                                </Grid>

                                <!-- 6. Conmutar Disposición de Paneles -->
                                <Button Style="{StaticResource SidebarIconButton}" Click="BtnToggleLayout_Click" ToolTip="Alternar Disposición de Paneles (Paralelo Horizontal / Apilado Vertical)">
                                    <TextBlock Text="PAN" FontSize="11" FontWeight="Bold" FontFamily="Arial"/>
                                </Button>
                            </StackPanel>

                            <!-- Iconos Inferiores -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Button Style="{StaticResource SidebarIconButton}" Click="BtnConfirmChanges_Click" ToolTip="Confirmar y Aceptar los Cambios Actuales como Línea Base">
                                    <TextBlock Text="OK" FontSize="11" FontWeight="Bold" FontFamily="Arial" Foreground="{StaticResource BrushAccentSage}"/>
                                </Button>
                                <Grid>
                                    <Border x:Name="IndSettings" Width="2" Height="20" Background="{StaticResource BrushAccentBlue}" HorizontalAlignment="Left" Margin="-5,0,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnNavSettings" Style="{StaticResource SidebarIconButton}" Click="BtnNavSettings_Click" ToolTip="Configuración del Motor de Inferencia Local (Qwen 2.5 Coder 7B) y Editor">
                                        <TextBlock Text="CFG" FontSize="11" FontWeight="Bold" FontFamily="Arial"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- COL 1: Panel Lateral Desplegable Animado              -->
                    <!-- ===================================================== -->
                    <Border x:Name="SideDrawerBorder"
                            Grid.Column="1"
                            Width="0"
                            Background="{StaticResource BrushBgDrawer}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="0,0,1,0"
                            Margin="0,0,4,0"
                            ClipToBounds="True">
                        <Grid Width="280">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Cabecera del Panel Lateral -->
                            <Border Grid.Row="0" Background="{StaticResource BrushBgSectionHeader}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtDrawerTitle" Grid.Column="0" Text="EXPLORADOR DEL PROYECTO" FontFamily="Arial" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Content="X" Style="{StaticResource ToolbarMiniBtn}" VerticalAlignment="Center" Click="BtnCloseDrawer_Click" ToolTip="Cerrar panel lateral"/>
                                </Grid>
                            </Border>

                            <!-- Barra de Herramientas del Panel Lateral -->
                            <Border x:Name="DrawerSubToolbar" Grid.Row="1" Padding="8,6" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <WrapPanel x:Name="DrawerExplorerActions" Orientation="Horizontal">
                                        <Button Content="[+] Subir" Style="{StaticResource ToolbarMiniBtn}" Click="BtnOpenExternalFile_Click" ToolTip="Importar archivos desde el equipo"/>
                                        <Button Content="[+] Nuevo" Style="{StaticResource ToolbarMiniBtn}" Click="BtnNewFile_Click" ToolTip="Crear un nuevo archivo en el espacio de trabajo"/>
                                        <Button Content="[>] Abrir Carpeta" Style="{StaticResource ToolbarMiniBtn}" Click="BtnOpenFolder_Click" ToolTip="Abrir directorio completo"/>
                                        <Button Content="[S] Guardar" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSaveFile_Click" ToolTip="Guardar archivo activo"/>
                                    </WrapPanel>

                                    <TextBox x:Name="TxtDrawerSearch"
                                             Visibility="Collapsed"
                                             Background="#0b0e14"
                                             Foreground="{StaticResource BrushTextPrimary}"
                                             CaretBrush="{StaticResource BrushAccentBlue}"
                                             BorderBrush="{StaticResource BrushBorderStrong}"
                                             BorderThickness="1"
                                             Padding="6,4"
                                             FontFamily="Arial"
                                             FontSize="12"
                                             TextChanged="TxtDrawerSearch_TextChanged"/>

                                    <!-- Panel de Clonación de Repositorios Git -->
                                    <StackPanel x:Name="DrawerGitClonePanel" Visibility="Collapsed">
                                        <TextBlock Text="URL del Repositorio Git (HTTPS / SSH / Ruta Local):" FontFamily="Arial" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="2,0,0,4"/>
                                        <TextBox x:Name="TxtGitCloneUrl"
                                                 Background="#0b0e14"
                                                 Foreground="{StaticResource BrushTextPrimary}"
                                                 CaretBrush="{StaticResource BrushAccentBlue}"
                                                 BorderBrush="{StaticResource BrushBorderStrong}"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontFamily="Consolas"
                                                 FontSize="11.5"
                                                 Text="https://github.com/"/>
                                        <Grid Margin="0,6,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="[Git] Clonar y Cargar Proyecto" Style="{StaticResource ToolbarMiniBtn}" Foreground="{StaticResource BrushAccentBlue}" FontWeight="SemiBold" Click="BtnExecuteGitClone_Click"/>
                                            <Button Grid.Column="1" Content="[>] Directorio Local" Style="{StaticResource ToolbarMiniBtn}" Click="BtnOpenFolder_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Contenido Dinámico del Panel Lateral -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="6">
                                <StackPanel x:Name="DrawerItemsContainer"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- COL 2: Espacio de Trabajo Dividido (Editor + IA)      -->
                    <!-- ===================================================== -->
                    <Grid x:Name="WorkspaceGrid" Grid.Column="2" Margin="4,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="WorkspaceColLeft" Width="1.08*" MinWidth="280"/>
                            <ColumnDefinition x:Name="WorkspaceColSplitter" Width="6"/>
                            <ColumnDefinition x:Name="WorkspaceColRight" Width="1.02*" MinWidth="280"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="WorkspaceRowTop" Height="*"/>
                            <RowDefinition x:Name="WorkspaceRowSplitter" Height="0"/>
                            <RowDefinition x:Name="WorkspaceRowBottom" Height="0"/>
                        </Grid.RowDefinitions>

                        <!-- ================================================= -->
                        <!-- PANEL IZQUIERDO: Editor + Auditoría SAST + AST    -->
                        <!-- ================================================= -->
                        <Border x:Name="LeftWorkstationPane"
                                Grid.Column="0" Grid.Row="0"
                                Background="{StaticResource BrushBgPane}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="RowCodeEditor" Height="1.55*" MinHeight="160"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition x:Name="RowVulnSection" Height="0.92*" MinHeight="28"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition x:Name="RowAstHexSection" Height="0.85*" MinHeight="28"/>
                                </Grid.RowDefinitions>

                                <!-- 1. EDITOR DE CÓDIGO CON PROGRESO Y CONFIRMACIÓN EN VIVO -->
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>   <!-- Pestañas de Archivos del Usuario y Acciones -->
                                        <RowDefinition Height="26"/>   <!-- Ruta del Archivo y Contadores de Diferencias -->
                                        <RowDefinition Height="Auto"/> <!-- Barra de Progreso y Confirmación de Cambios IA -->
                                        <RowDefinition Height="*"/>    <!-- Superficie de Edición + Minimapa Dinámico -->
                                    </Grid.RowDefinitions>

                                    <!-- Barra de Pestañas del Editor -->
                                    <Border Grid.Row="0" Background="{StaticResource BrushBgSectionHeader}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="EditorTabsPanel" Orientation="Horizontal"/>
                                            </ScrollViewer>

                                            <!-- Barra de Acciones del Editor -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Button Content="[+] Subir" Style="{StaticResource ToolbarMiniBtn}" Click="BtnOpenExternalFile_Click" ToolTip="Subir e importar archivo(s) del usuario al editor"/>
                                                <Button Content="[+] Nuevo" Style="{StaticResource ToolbarMiniBtn}" Click="BtnNewFile_Click" ToolTip="Crear un archivo nuevo en el espacio de trabajo"/>
                                                <Button x:Name="BtnDiffModeToggle" Content="[DIFF] Diferencias: ACTIVO" Style="{StaticResource ToolbarMiniBtn}" Click="BtnToggleDiffView_Click" ToolTip="Mostrar u ocultar líneas añadidas en verde (+) y eliminadas en rojo (-)"/>
                                                <Button Content="[Guardar]" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSaveFile_Click" ToolTip="Guardar cambios en disco (Ctrl+S)"/>
                                                <Button Content="[AUTO] Remediación IA en Vivo" Style="{StaticResource ToolbarMiniBtn}" Foreground="{StaticResource BrushAccentSage}" FontWeight="SemiBold" Click="BtnApplyPatch_Click" ToolTip="Aplicar refactorización y corrección de vulnerabilidades mostrando el progreso paso a paso en el editor"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Barra de Ruta Léxica y Leyenda de Control de Cambios (SIN SOLAPAMIENTO) -->
                                    <Border Grid.Row="1" Background="#0b0e14" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="10,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="TxtBreadcrumbPath"
                                                       Grid.Column="0"
                                                       Text="Espacio de Trabajo › Sin archivo seleccionado"
                                                       FontFamily="Arial, Consolas"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,8,0"/>

                                            <TextBlock x:Name="TxtCursorPos"
                                                       Grid.Column="1"
                                                       Text="Lín 1, Col 1"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource BrushDiffAddedBar}" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="TxtAddedCount" Text="+0 añadidas" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushAccentSage}" Margin="0,0,10,0"/>
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource BrushDiffRemovedBar}" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="TxtRemovedCount" Text="-0 eliminadas" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushDiffRemovedBar}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- BARRA DE PROGRESO Y CONFIRMACIÓN DE CAMBIOS EN EL EDITOR -->
                                    <Border x:Name="PanelProgresoEdicionIA"
                                            Grid.Row="2"
                                            Visibility="Collapsed"
                                            Background="#111926"
                                            BorderBrush="#2a4a7f"
                                            BorderThickness="0,0,0,1"
                                            Padding="10,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <Border x:Name="DotProgresoIA" Width="7" Height="7" CornerRadius="4" Background="{StaticResource BrushAccentBlue}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtFaseProgresoIA"
                                                               Text="Aplicando modificaciones del modelo de IA en el editor..."
                                                               FontFamily="Arial, Consolas"
                                                               FontSize="11.5"
                                                               FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                                </StackPanel>

                                                <TextBlock x:Name="TxtPorcentajeProgresoIA"
                                                           Grid.Column="1"
                                                           Text="0%"
                                                           FontFamily="Consolas"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource BrushAccentSage}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>

                                                <!-- Botones de Confirmación o Reversión de Cambios -->
                                                <StackPanel x:Name="PanelBotonesConfirmacion" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <Button Content="[OK] Confirmar y Guardar Cambios"
                                                            Style="{StaticResource ToolbarMiniBtn}"
                                                            Foreground="{StaticResource BrushAccentSage}"
                                                            FontWeight="Bold"
                                                            Click="BtnConfirmChanges_Click"
                                                            ToolTip="Aceptar las modificaciones actuales como nueva versión confirmada del archivo"/>
                                                    <Button Content="[REV] Revertir al Original"
                                                            Style="{StaticResource ToolbarMiniBtn}"
                                                            Foreground="{StaticResource BrushDiffRemovedBar}"
                                                            Click="BtnRevertChanges_Click"
                                                            ToolTip="Descartar los cambios aplicados y restaurar el código anterior"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid x:Name="ContenedorBarraProgresoIA" Grid.Row="1" Height="4" Background="#0b0e14" Margin="0,5,0,0" ClipToBounds="True">
                                                <Border x:Name="BarraProgresoEdicionIA"
                                                        HorizontalAlignment="Left"
                                                        Width="0"
                                                        Height="4"
                                                        CornerRadius="2"
                                                        Background="{StaticResource BrushAccentBlue}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Superficie Principal de Edición + Minimapa Dinámico -->
                                    <Grid Grid.Row="3" Background="{StaticResource BrushBgPane}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>                     <!-- Numeración + Diferencias + Editor -->
                                            <ColumnDefinition x:Name="ColMinimap" Width="84"/> <!-- Vista Previa Estructural (Minimapa) -->
                                        </Grid.ColumnDefinitions>

                                        <ScrollViewer x:Name="EditorScrollViewer"
                                                      Grid.Column="0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      ScrollChanged="EditorScrollViewer_ScrollChanged">
                                            <Grid MinHeight="260">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/> <!-- Margen de Líneas e Indicadores +/- -->
                                                    <ColumnDefinition Width="*"/>  <!-- Capas de Resaltado Diff + Editor Interactivo -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Capa 0: Resaltado por Línea (Recortado para NUNCA estirar el ancho horizontal) -->
                                                <StackPanel x:Name="DiffBackdropPanel"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,6,0,6"
                                                            ClipToBounds="True"
                                                            IsHitTestVisible="False"/>

                                                <!-- Capa 1: Numeración de Líneas e Indicadores +/-/! -->
                                                <StackPanel x:Name="LineNumbersPanel"
                                                            Grid.Column="0"
                                                            Margin="0,6,0,6"
                                                            IsHitTestVisible="False"/>

                                                <!-- Capa 2: Editor de Código Fuente Real -->
                                                <TextBox x:Name="CodeEditorTextBox"
                                                         Grid.Column="1"
                                                         Background="Transparent"
                                                         Foreground="{StaticResource BrushTextPrimary}"
                                                         CaretBrush="{StaticResource BrushAccentBlue}"
                                                         SelectionBrush="#264f78"
                                                         BorderThickness="0"
                                                         FontFamily="Consolas"
                                                         FontSize="13"
                                                         TextBlock.LineHeight="20"
                                                         TextBlock.LineStackingStrategy="BlockLineHeight"
                                                         AcceptsReturn="True"
                                                         AcceptsTab="True"
                                                         Padding="6,6,14,6"
                                                         TextChanged="CodeEditorTextBox_TextChanged"
                                                         SelectionChanged="CodeEditorTextBox_SelectionChanged"/>
                                            </Grid>
                                        </ScrollViewer>

                                        <!-- VISTA PREVIA ESTRUCTURAL EN TIEMPO REAL (MINIMAPA) -->
                                        <Border x:Name="MinimapPanel"
                                                Grid.Column="1"
                                                Background="#0a0d12"
                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                BorderThickness="1,0,0,0"
                                                ClipToBounds="True"
                                                Cursor="Hand"
                                                ToolTip="Vista previa estructural del código en tiempo real (Verde: líneas añadidas, Rojo: líneas eliminadas o vulnerables)"
                                                MouseLeftButtonDown="Minimap_MouseDown"
                                                MouseMove="Minimap_MouseMove">
                                            <Grid>
                                                <Canvas x:Name="MinimapCanvas" Margin="0" IsHitTestVisible="False"/>
                                                <Border x:Name="MinimapViewport"
                                                        Height="54"
                                                        VerticalAlignment="Top"
                                                        Margin="1,0,1,0"
                                                        Background="#184493f8"
                                                        BorderBrush="#454493f8"
                                                        BorderThickness="1"
                                                        CornerRadius="2"
                                                        IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- Divisor Horizontal 1 -->
                                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource BrushBorderSubtle}" Cursor="SizeNS"/>

                                <!-- ================================================= -->
                                <!-- 2. AUDITORÍA SAST (OWASP/CWE) Y CALIDAD ISO-25010 -->
                                <!-- ================================================= -->
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{StaticResource BrushBgSectionHeader}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="10,0" Cursor="Hand" MouseLeftButtonDown="VulnHeader_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="TxtVulnChevron" Text="v " FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="VULNERABILIDADES (SAST / CWE) Y CALIDAD (ISO 25010)" FontFamily="Arial" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock x:Name="TxtAstSummaryCount" Text="  (analizando...)" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="[AUTO] Corregir Todo en Vivo" Style="{StaticResource ToolbarMiniBtn}" Foreground="{StaticResource BrushAccentSage}" FontWeight="Bold" Click="BtnApplyPatch_Click" ToolTip="Remedia todas las vulnerabilidades detectadas mostrando el progreso en el editor"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer x:Name="AstScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0b0e14" Padding="10,6">
                                        <StackPanel x:Name="AstTreeContainer"/>
                                    </ScrollViewer>
                                </Grid>

                                <!-- Divisor Horizontal 2 -->
                                <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource BrushBorderSubtle}" Cursor="SizeNS"/>

                                <!-- ================================================= -->
                                <!-- 3. ÁRBOL SINTÁCTICO (AST) E INSPECCIÓN HEX UTF-8  -->
                                <!-- ================================================= -->
                                <Grid Grid.Row="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{StaticResource BrushBgSectionHeader}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="10,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="TxtHexChevron" Text="v " FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" MouseLeftButtonDown="HexHeader_Click" Cursor="Hand"/>
                                                <Button x:Name="BtnTabAstMetrics" Content="Árbol Sintáctico (AST) y Métricas ISO" Style="{StaticResource ToolbarMiniBtn}" Foreground="{StaticResource BrushAccentBlue}" FontWeight="Bold" Click="BtnTabAstMetrics_Click"/>
                                                <Button x:Name="BtnTabHexView" Content="Inspección Hexadecimal (UTF-8)" Style="{StaticResource ToolbarMiniBtn}" Click="BtnTabHexView_Click"/>
                                                <TextBlock x:Name="TxtHexByteCount" Text="  (0 bytes)" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="[HEX] Copiar Volcado" Style="{StaticResource ToolbarMiniBtn}" Click="BtnCopyHex_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid x:Name="BottomInspectorContentGrid" Grid.Row="1" Background="#0b0e14">
                                        <!-- Subvista A: Símbolos AST y Métricas de Ingeniería ISO/IEC 25010 -->
                                        <ScrollViewer x:Name="AstMetricsScrollViewer" VerticalScrollBarVisibility="Auto" Padding="10,6">
                                            <StackPanel x:Name="AstMetricsContainer"/>
                                        </ScrollViewer>

                                        <!-- Subvista B: Inspección Hexadecimal de Bytes en Tiempo Real -->
                                        <ScrollViewer x:Name="HexScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition x:Name="ColHexDivider" Width="16"/>
                                                    <ColumnDefinition x:Name="ColHexAscii" Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock x:Name="TxtHexOffsets" Grid.Column="0" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextMuted}" LineHeight="19"/>
                                                <TextBlock x:Name="TxtHexBytes" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" LineHeight="19"/>
                                                <Border x:Name="HexDividerLine" Grid.Column="2" Width="1" Background="{StaticResource BrushBorderSubtle}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtHexAscii" Grid.Column="3" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" LineHeight="19"/>
                                            </Grid>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Divisores entre Panel Izquierdo y Derecho -->
                        <GridSplitter x:Name="MainVerticalSplitter" Grid.Column="1" Grid.Row="0" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>
                        <GridSplitter x:Name="MainHorizontalSplitter" Grid.Column="0" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Visibility="Collapsed" Cursor="SizeNS"/>

                        <!-- ================================================= -->
                        <!-- PANEL DERECHO: Asistente IA de Ingeniería y Seg.  -->
                        <!-- ================================================= -->
                        <Border x:Name="RightWorkstationPane"
                                Grid.Column="2" Grid.Row="0"
                                Background="{StaticResource BrushBgPane}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>   <!-- Cabecera del Asistente IA -->
                                    <RowDefinition Height="26"/>   <!-- Barra de Optimización de Tokens y Especialidades -->
                                    <RowDefinition Height="*"/>    <!-- Flujo de Interacción Técnica -->
                                    <RowDefinition Height="Auto"/> <!-- Selectores de Especialidades de Ingeniería -->
                                    <RowDefinition Height="52"/>   <!-- Barra de Consulta Técnica -->
                                </Grid.RowDefinitions>

                                <!-- Cabecera del Asistente -->
                                <Border Grid.Row="0" Background="{StaticResource BrushBgSectionHeader}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource BrushBgPane}" BorderBrush="{StaticResource BrushAccentBlue}" BorderThickness="0,2,1,0" Padding="12,0" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="DotAiConnection" Width="7" Height="7" CornerRadius="4" Background="{StaticResource BrushAccentBlue}" Margin="0,0,7,0"/>
                                                <TextBlock Text="Asistente de Ingeniería de Software y Ciberseguridad (IA Local + RAG)" FontFamily="Arial" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Button x:Name="BtnInstallOrCheckAi" Content="[LLM] Motor IA Local" Style="{StaticResource ToolbarMiniBtn}" Foreground="{StaticResource BrushAccentSage}" Click="BtnInstallOrCheckAi_Click" ToolTip="Verificar conexión o iniciar modelo local Qwen 2.5 Coder 7B con RAG"/>
                                            <Button Content="[ESP] Especialidades" Style="{StaticResource ToolbarMiniBtn}" Click="BtnNavSkills_Click" ToolTip="Configurar especialidades técnicas activas (12 disponibles)"/>
                                            <Button Content="[CLR] Limpiar" Style="{StaticResource ToolbarMiniBtn}" Click="BtnClearChat_Click" ToolTip="Limpiar historial de consultas"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Barra de Compresión de Contexto y Prevención de Alucinaciones (SIN SOLAPAMIENTO) -->
                                <Border Grid.Row="1" Background="#0b0e14" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="10,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtSkillRouterStatus"
                                                   Grid.Column="0"
                                                   Text="[RAG] 12 Especialidades Activas  ·  Anclaje AST: ACTIVO  ·  0 Alucinaciones"
                                                   FontFamily="Arial, Consolas"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TxtTokenSavingsBadge"
                                                   Grid.Column="1"
                                                   Text="Ahorro: ~78% tokens"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushAccentSage}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Flujo de Conversación -->
                                <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="12,10">
                                    <StackPanel x:Name="ChatContainer"/>
                                </ScrollViewer>

                                <!-- Botones de Especialidades de Ingeniería de Software y Ciberseguridad -->
                                <Border Grid.Row="3" Background="#0e1218" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="8,5">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="[UI/UX] Accesibilidad (WCAG 2.2)" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSkillUiUx_Click" ToolTip="Especialidad: Sistemas de Diseño e Interfaces Accesibles WCAG 2.2"/>
                                        <Button Content="[BACKEND] Arquitectura Limpia (SOLID)" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSkillBackend_Click" ToolTip="Especialidad: Arquitectura Limpia, SOLID y APIs REST/gRPC"/>
                                        <Button Content="[SQL] Optimizar Modelo Relacional (3FN)" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSkillDatabase_Click" ToolTip="Especialidad: Analizar y optimizar el archivo SQL o modelo de datos activo en el editor"/>
                                        <Button Content="[REQ] Ingeniería de Requisitos (ISO 29148)" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSkillRequirements_Click" ToolTip="Especialidad: Ingeniería de Requisitos ISO/IEC/IEEE 29148 y Sintaxis EARS"/>
                                        <Button Content="[ISO] Calidad y Seguridad (ISO 25010)" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSkillIsoQuality_Click" ToolTip="Especialidad: Evaluación de Calidad de Software ISO/IEC 25010 y Controles ISO 27001"/>
                                        <Button Content="[TEST] Pruebas y Valores Límite (BVA)" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSkillTesting_Click" ToolTip="Especialidad: Verificación y Análisis de Valores Límite (BVA)"/>
                                        <Button Content="[SEC] Auditoría SAST y Parcheo (OWASP)" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSkillSecurity_Click" ToolTip="Especialidad: Detección SAST y Remediación Progresiva en el Editor"/>
                                        <Button Content="[DEVOPS] Contenedores Seguros (Docker/K8s)" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSkillDevops_Click" ToolTip="Especialidad: Dockerfiles multi-stage rootless y CI/CD"/>
                                        <Button Content="[API] Seguridad OAuth2/JWT y OpenAPI" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSkillApiSec_Click" ToolTip="Especialidad: Flujos OAuth2/OIDC, tokens JWT RS256 y contratos OpenAPI 3.1"/>
                                        <Button Content="[PERF] Rendimiento Zero-Copy y Memoria" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSkillPerf_Click" ToolTip="Especialidad: Prevención de fugas de memoria y optimización de latencia"/>
                                        <Button Content="[EVENT] Microservicios y Patrón Saga" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSkillMicroservices_Click" ToolTip="Especialidad: EDA asíncrono, colas Kafka/RabbitMQ y outbox"/>
                                    </WrapPanel>
                                </Border>

                                <!-- Barra Inferior de Entrada de Consultas -->
                                <Border Grid.Row="4" Background="#0b0e14" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="10,8">
                                    <Border Background="#11161e" BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1" CornerRadius="4" Padding="10,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="TxtPrompt"
                                                     Grid.Column="0"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource BrushTextPrimary}"
                                                     CaretBrush="{StaticResource BrushAccentBlue}"
                                                     BorderThickness="0"
                                                     FontFamily="Arial"
                                                     FontSize="12.5"
                                                     VerticalContentAlignment="Center"
                                                     KeyDown="TxtPrompt_KeyDown"
                                                     Text="Solicite refactorización en vivo del archivo, diseño UI/UX, arquitectura Backend, esquema SQL 3FN, requisitos ISO 29148 o auditoría CWE..."
                                                     GotFocus="TxtPrompt_GotFocus"
                                                     LostFocus="TxtPrompt_LostFocus"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Ejecutar [Enter]" Style="{StaticResource ToolbarMiniBtn}" Foreground="{StaticResource BrushAccentBlue}" FontWeight="Bold" Click="BtnSend_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========================================================= -->
                <!-- FILA 2: Barra de Telemetría de Hardware y Motor IA Local  -->
                <!-- ========================================================= -->
                <Border Grid.Row="2"
                        Background="{StaticResource BrushBgHeader}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,6,6">
                    <Grid Margin="14,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Indicadores de Telemetría de Hardware en Tiempo Real -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="DotTelemetryStatus" Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrushAccentSage}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <TextBlock Text="MODELO IA: " FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTelemetryModel" Text="Qwen 2.5 Coder 7B (Q4_K_M) + 12 Especialidades [RAG ACTIVO]" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>

                            <TextBlock Text="   ·   " FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>

                            <TextBlock Text="VRAM GPU: " FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTelemetryVram" Text="Consultando RTX 3050..." FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>

                            <TextBlock Text="   ·   " FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>

                            <TextBlock Text="TEMP. GPU: " FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTelemetryTemp" Text="-- °C" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>

                            <StackPanel x:Name="TelemetryExtraGroup" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="   ·   " FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="RAM SISTEMA: " FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTelemetryRam" Text="-- / 32.0 GB" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Estado del Espacio de Trabajo y Enrutador -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtGitBranchStatus" Text="[LOCAL] Espacio de Trabajo Aislado" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtEngineModeStatus" Text="ENRUTADOR DETERMINISTA + RAG ACTIVO" FontFamily="Arial" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccentSage}" VerticalAlignment="Center"/>
                            <TextBlock Text=" [::]" FontFamily="Consolas" FontSize="11" Foreground="#3b4654" VerticalAlignment="Bottom" Margin="8,0,-10,2" ToolTip="Arrastre cualquier borde o esquina para redimensionar la ventana"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Controladores Nativos de Redimensionamiento en 8 Direcciones -->
        <Thumb Height="6" VerticalAlignment="Top" Margin="10,0" Cursor="SizeNS" Opacity="0" PreviewMouseLeftButtonDown="ResizeTop_MouseDown"/>
        <Thumb Height="6" VerticalAlignment="Bottom" Margin="10,0" Cursor="SizeNS" Opacity="0" PreviewMouseLeftButtonDown="ResizeBottom_MouseDown"/>
        <Thumb Width="6" HorizontalAlignment="Left" Margin="0,10" Cursor="SizeWE" Opacity="0" PreviewMouseLeftButtonDown="ResizeLeft_MouseDown"/>
        <Thumb Width="6" HorizontalAlignment="Right" Margin="0,10" Cursor="SizeWE" Opacity="0" PreviewMouseLeftButtonDown="ResizeRight_MouseDown"/>

        <Thumb Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Opacity="0" PreviewMouseLeftButtonDown="ResizeTopLeft_MouseDown"/>
        <Thumb Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Opacity="0" PreviewMouseLeftButtonDown="ResizeTopRight_MouseDown"/>
        <Thumb Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Opacity="0" PreviewMouseLeftButtonDown="ResizeBottomLeft_MouseDown"/>
        <Thumb Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0" PreviewMouseLeftButtonDown="ResizeBottomRight_MouseDown"/>
    </Grid>
</Window>
