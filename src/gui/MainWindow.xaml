<Window x:Class="Secdev.Workstation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="secdev — Native Security &amp; Code Workstation"
        Height="880" Width="1480"
        MinHeight="480" MinWidth="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged"
        KeyDown="Window_KeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="6"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <!-- Outer Architectural Frame -->
        <Border x:Name="OuterBorder"
                Background="{StaticResource BrushBgRoot}"
                BorderBrush="{StaticResource BrushBorderStrong}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/> <!-- Row 0: Header Bar -->
                    <RowDefinition Height="*"/>  <!-- Row 1: Main Workspace -->
                    <RowDefinition Height="34"/> <!-- Row 2: Real Hardware Telemetry Bar -->
                </Grid.RowDefinitions>

                <!-- ========================================================= -->
                <!-- ROW 0: Architectural Title & Navigation Bar               -->
                <!-- ========================================================= -->
                <Border Grid.Row="0"
                        Background="{StaticResource BrushBgHeader}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="14,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Brand & Active File Status -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrushAccentSage}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="secdev"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock x:Name="TxtHeaderSubtitle"
                                       Text="  —  engine v1.0.4-native  ·  air-gapped workspace"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Center-Right: Quick Actions & Viewport Presets -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border Background="#141a23" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtDiffSummaryBadge"
                                           Text="+0  -0 lines"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>
                            <Border Background="#141a23" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtResolutionBadge"
                                           Text="1480×880 [WIDE]"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>
                            <Button Content="S" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSizeSmall_Click" ToolTip="Compact Viewport (820×620)"/>
                            <Button Content="M" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSizeMedium_Click" ToolTip="Medium Viewport (1160×740)"/>
                            <Button Content="L" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSizeLarge_Click" ToolTip="Wide Workstation (1520×900)"/>
                        </StackPanel>

                        <!-- Right: Window Controls -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="—" Style="{StaticResource WindowControlBtn}" Click="BtnMinimize_Click" ToolTip="Minimize"/>
                            <Button x:Name="BtnMaxRestore" Content="▢" Style="{StaticResource WindowControlBtn}" Click="BtnMaximize_Click" ToolTip="Maximize / Restore"/>
                            <Button Content="✕" Style="{StaticResource WindowControlBtn}" Click="BtnClose_Click" ToolTip="Close"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- ROW 1: Main Workstation Body                              -->
                <!-- ========================================================= -->
                <Grid Grid.Row="1" Margin="0,4,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>   <!-- Col 0: Left Activity Icon Rail -->
                        <ColumnDefinition Width="Auto"/> <!-- Col 1: Smooth Animated Side Drawer (Explorer/Search/Git/Settings) -->
                        <ColumnDefinition Width="*"/>    <!-- Col 2: Main Split Workspace -->
                    </Grid.ColumnDefinitions>

                    <!-- ===================================================== -->
                    <!-- COL 0: Left Activity Sidebar Rail                     -->
                    <!-- ===================================================== -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BrushBgSidebar}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top Navigation Icons -->
                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <!-- 1. File Explorer -->
                                <Grid>
                                    <Border x:Name="IndExplorer" Width="2" Height="20" Background="{StaticResource BrushAccentBlue}" HorizontalAlignment="Left" Margin="-5,0,0,0"/>
                                    <Button x:Name="BtnNavExplorer" Style="{StaticResource SidebarIconButton}" Click="BtnNavExplorer_Click" ToolTip="Workspace Files (Explorer)">
                                        <TextBlock Text="❐" FontSize="14" FontFamily="Segoe UI Symbol"/>
                                    </Button>
                                </Grid>

                                <!-- 2. Global Code Search -->
                                <Grid>
                                    <Border x:Name="IndSearch" Width="2" Height="20" Background="{StaticResource BrushAccentBlue}" HorizontalAlignment="Left" Margin="-5,0,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnNavSearch" Style="{StaticResource SidebarIconButton}" Click="BtnNavSearch_Click" ToolTip="Search Code Across Repository">
                                        <TextBlock Text="⌕" FontSize="16" FontFamily="Segoe UI Symbol"/>
                                    </Button>
                                </Grid>

                                <!-- 3. Git & Line Diff Control -->
                                <Grid>
                                    <Border x:Name="IndGit" Width="2" Height="20" Background="{StaticResource BrushAccentBlue}" HorizontalAlignment="Left" Margin="-5,0,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnNavGit" Style="{StaticResource SidebarIconButton}" Click="BtnNavGit_Click" ToolTip="Git Status &amp; Diff Inspector">
                                        <TextBlock Text="⑂" FontSize="14" FontFamily="Segoe UI Symbol"/>
                                    </Button>
                                </Grid>

                                <!-- 4. Security Audit & AST Runner -->
                                <Grid>
                                    <Border x:Name="IndAudit" Width="2" Height="20" Background="{StaticResource BrushAccentBlue}" HorizontalAlignment="Left" Margin="-5,0,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnNavAudit" Style="{StaticResource SidebarIconButton}" Click="BtnNavAudit_Click" ToolTip="Run Real-Time Security Audit">
                                        <TextBlock Text="▷" FontSize="14" FontFamily="Segoe UI Symbol"/>
                                    </Button>
                                </Grid>

                                <!-- 5. Toggle Layout Orientation -->
                                <Button Style="{StaticResource SidebarIconButton}" Click="BtnToggleLayout_Click" ToolTip="Switch Side-by-Side / Stacked Layout">
                                    <TextBlock Text="◫" FontSize="15" FontFamily="Segoe UI Symbol"/>
                                </Button>
                            </StackPanel>

                            <!-- Bottom Navigation Icons -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Button Style="{StaticResource SidebarIconButton}" Click="BtnResetBaseline_Click" ToolTip="Reset File Diff Baseline to Current">
                                    <TextBlock Text="↺" FontSize="15" FontFamily="Segoe UI Symbol"/>
                                </Button>
                                <Grid>
                                    <Border x:Name="IndSettings" Width="2" Height="20" Background="{StaticResource BrushAccentBlue}" HorizontalAlignment="Left" Margin="-5,0,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnNavSettings" Style="{StaticResource SidebarIconButton}" Click="BtnNavSettings_Click" ToolTip="Engine &amp; Model Settings">
                                        <TextBlock Text="⚙" FontSize="15" FontFamily="Segoe UI Symbol"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- COL 1: Smooth Collapsible Side Drawer                 -->
                    <!-- ===================================================== -->
                    <Border x:Name="SideDrawerBorder"
                            Grid.Column="1"
                            Width="0"
                            Background="{StaticResource BrushBgDrawer}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="0,0,1,0"
                            Margin="0,0,4,0"
                            ClipToBounds="True">
                        <Grid Width="240">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Drawer Header -->
                            <Border Grid.Row="0" Background="{StaticResource BrushBgSectionHeader}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="12,0">
                                <Grid>
                                    <TextBlock x:Name="TxtDrawerTitle" Text="WORKSPACE EXPLORER" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                    <Button Content="✕" Style="{StaticResource ToolbarMiniBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnCloseDrawer_Click" ToolTip="Close Panel"/>
                                </Grid>
                            </Border>

                            <!-- Drawer Sub-Toolbar (Search Input or File Actions) -->
                            <Border x:Name="DrawerSubToolbar" Grid.Row="1" Padding="8,6" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel x:Name="DrawerExplorerActions" Orientation="Horizontal">
                                        <Button Content="+ Open File..." Style="{StaticResource ToolbarMiniBtn}" Click="BtnOpenExternalFile_Click"/>
                                        <Button Content="💾 Save" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSaveFile_Click"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtDrawerSearch"
                                             Visibility="Collapsed"
                                             Background="#0b0e14"
                                             Foreground="{StaticResource BrushTextPrimary}"
                                             CaretBrush="{StaticResource BrushAccentBlue}"
                                             BorderBrush="{StaticResource BrushBorderStrong}"
                                             BorderThickness="1"
                                             Padding="6,4"
                                             FontFamily="Segoe UI"
                                             FontSize="12"
                                             TextChanged="TxtDrawerSearch_TextChanged"/>
                                </Grid>
                            </Border>

                            <!-- Drawer Dynamic Content List -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="6">
                                <StackPanel x:Name="DrawerItemsContainer"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- COL 2: Main Split Workspace (Left Editor + Right AI)  -->
                    <!-- ===================================================== -->
                    <Grid x:Name="WorkspaceGrid" Grid.Column="2" Margin="4,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="WorkspaceColLeft" Width="1.08*" MinWidth="280"/>
                            <ColumnDefinition x:Name="WorkspaceColSplitter" Width="6"/>
                            <ColumnDefinition x:Name="WorkspaceColRight" Width="1.0*" MinWidth="280"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="WorkspaceRowTop" Height="*"/>
                            <RowDefinition x:Name="WorkspaceRowSplitter" Height="0"/>
                            <RowDefinition x:Name="WorkspaceRowBottom" Height="0"/>
                        </Grid.RowDefinitions>

                        <!-- ================================================= -->
                        <!-- LEFT PANE: Real Code Editor + Hex + AST           -->
                        <!-- ================================================= -->
                        <Border x:Name="LeftWorkstationPane"
                                Grid.Column="0" Grid.Row="0"
                                Background="{StaticResource BrushBgPane}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="RowCodeEditor" Height="1.45*" MinHeight="140"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition x:Name="RowHexSection" Height="0.82*" MinHeight="28"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition x:Name="RowAstSection" Height="0.95*" MinHeight="28"/>
                                </Grid.RowDefinitions>

                                <!-- 1. REAL FUNCTIONAL CODE EDITOR + LIVE MINIMAP -->
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/> <!-- File Tabs & Toolbar -->
                                        <RowDefinition Height="24"/> <!-- Breadcrumbs & Live Diff Legend -->
                                        <RowDefinition Height="*"/>  <!-- Editor + Live Minimap -->
                                    </Grid.RowDefinitions>

                                    <!-- Editor Tab Bar -->
                                    <Border Grid.Row="0" Background="{StaticResource BrushBgSectionHeader}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Open File Tabs -->
                                            <StackPanel x:Name="EditorTabsPanel" Grid.Column="0" Orientation="Horizontal"/>

                                            <!-- Right Editor Action Toolbar -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Button x:Name="BtnDiffModeToggle" Content="⇄ Inline Diff: ON" Style="{StaticResource ToolbarMiniBtn}" Click="BtnToggleDiffView_Click" ToolTip="Toggle Red/Green Removed &amp; Added Lines"/>
                                                <Button Content="💾 Save" Style="{StaticResource ToolbarMiniBtn}" Click="BtnSaveFile_Click" ToolTip="Save File (Ctrl+S)"/>
                                                <Button Content="▷ Audit" Style="{StaticResource ToolbarMiniBtn}" Click="BtnNavAudit_Click" ToolTip="Analyze Code Security"/>
                                                <Button Content="◫" Style="{StaticResource ToolbarMiniBtn}" Click="BtnToggleLayout_Click" ToolTip="Toggle Split Orientation"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Breadcrumb & Diff Status Bar -->
                                    <Border Grid.Row="1" Background="#0b0e14" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="12,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtBreadcrumbPath" Text="secdev › src › exploit_audit.c" FontFamily="Segoe UI, Consolas" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock x:Name="TxtCursorPos" Text="   Ln 1, Col 1" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="12,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource BrushDiffAddedBar}" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="TxtAddedCount" Text="+0 added" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushAccentSage}" Margin="0,0,10,0"/>
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource BrushDiffRemovedBar}" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="TxtRemovedCount" Text="-0 removed" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushDiffRemovedBar}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Main Editor Surface + Live Dynamic Minimap -->
                                    <Grid Grid.Row="2" Background="{StaticResource BrushBgPane}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>                     <!-- Synchronized Gutter + Diff Backdrop + Code TextBox -->
                                            <ColumnDefinition x:Name="ColMinimap" Width="84"/> <!-- Real-Time Dynamic Code Minimap -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Synchronized Editor ScrollViewer -->
                                        <ScrollViewer x:Name="EditorScrollViewer"
                                                      Grid.Column="0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      ScrollChanged="EditorScrollViewer_ScrollChanged">
                                            <Grid MinHeight="300">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/> <!-- Line Numbers + Diff +/- Gutter -->
                                                    <ColumnDefinition Width="*"/>  <!-- Code Backdrop + Interactive TextBox -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Layer 0 (Col 0 & Col 1): Per-Line Diff Highlight Rows (Green Added / Red Removed) -->
                                                <StackPanel x:Name="DiffBackdropPanel" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,6" IsHitTestVisible="False"/>

                                                <!-- Layer 1 (Col 0): Line Numbers & Diff +/- Indicators -->
                                                <StackPanel x:Name="LineNumbersPanel" Grid.Column="0" Margin="0,6,0,6" IsHitTestVisible="False"/>

                                                <!-- Layer 2 (Col 1): Real Interactive Code Editor TextBox -->
                                                <TextBox x:Name="CodeEditorTextBox"
                                                         Grid.Column="1"
                                                         Background="Transparent"
                                                         Foreground="{StaticResource BrushTextPrimary}"
                                                         CaretBrush="{StaticResource BrushAccentBlue}"
                                                         SelectionBrush="#264f78"
                                                         BorderThickness="0"
                                                         FontFamily="Consolas"
                                                         FontSize="13"
                                                         TextBlock.LineHeight="20"
                                                         TextBlock.LineStackingStrategy="BlockLineHeight"
                                                         AcceptsReturn="True"
                                                         AcceptsTab="True"
                                                         Padding="6,6,14,6"
                                                         TextChanged="CodeEditorTextBox_TextChanged"
                                                         SelectionChanged="CodeEditorTextBox_SelectionChanged"/>
                                            </Grid>
                                        </ScrollViewer>

                                        <!-- REAL-TIME DYNAMIC CODE MINIMAP -->
                                        <Border x:Name="MinimapPanel"
                                                Grid.Column="1"
                                                Background="#0a0d12"
                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                BorderThickness="1,0,0,0"
                                                ClipToBounds="True"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="Minimap_MouseDown"
                                                MouseMove="Minimap_MouseMove">
                                            <Grid>
                                                <!-- Dynamic Canvas drawn directly from actual editor lines & diffs -->
                                                <Canvas x:Name="MinimapCanvas" Margin="4,6,4,6" IsHitTestVisible="False"/>

                                                <!-- Interactive Viewport Highlight Box -->
                                                <Border x:Name="MinimapViewport"
                                                        Height="54"
                                                        VerticalAlignment="Top"
                                                        Margin="2,6,2,0"
                                                        Background="#184493f8"
                                                        BorderBrush="#454493f8"
                                                        BorderThickness="1"
                                                        CornerRadius="2"
                                                        IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- Horizontal Splitter 1 -->
                                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource BrushBorderSubtle}" Cursor="SizeNS"/>

                                <!-- 2. REAL-TIME HEX INSPECTION SECTION -->
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{StaticResource BrushBgSectionHeader}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="10,0" Cursor="Hand" MouseLeftButtonDown="HexHeader_Click">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtHexChevron" Text="⌄ " FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="HEX INSPECTION" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock x:Name="TxtHexByteCount" Text="  (0 bytes)" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="Copy Hex" Style="{StaticResource ToolbarMiniBtn}" Click="BtnCopyHex_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer x:Name="HexScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0b0e14" Padding="12,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82"/>  <!-- Real Offset -->
                                                <ColumnDefinition Width="Auto"/> <!-- 16 Real Hex Bytes -->
                                                <ColumnDefinition x:Name="ColHexDivider" Width="16"/>
                                                <ColumnDefinition x:Name="ColHexAscii" Width="Auto"/> <!-- Real ASCII Decode -->
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="TxtHexOffsets" Grid.Column="0" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextMuted}" LineHeight="19"/>
                                            <TextBlock x:Name="TxtHexBytes" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" LineHeight="19"/>
                                            <Border x:Name="HexDividerLine" Grid.Column="2" Width="1" Background="{StaticResource BrushBorderSubtle}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtHexAscii" Grid.Column="3" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" LineHeight="19"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>

                                <!-- Horizontal Splitter 2 -->
                                <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource BrushBorderSubtle}" Cursor="SizeNS"/>

                                <!-- 3. REAL-TIME AST VULNERABILITY DETECTION SECTION -->
                                <Grid Grid.Row="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{StaticResource BrushBgSectionHeader}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="10,0" Cursor="Hand" MouseLeftButtonDown="AstHeader_Click">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtAstChevron" Text="⌄ " FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="AST VULNERABILITY DETECTION" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock x:Name="TxtAstSummaryCount" Text="  (live parser)" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                            </StackPanel>
                                            <Button Content="Apply Secure Patch" Style="{StaticResource ToolbarMiniBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnApplyPatch_Click"/>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer x:Name="AstScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0b0e14" Padding="10,6">
                                        <StackPanel x:Name="AstTreeContainer"/>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Splitters between Left and Right Workstation Panes -->
                        <GridSplitter x:Name="MainVerticalSplitter" Grid.Column="1" Grid.Row="0" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>
                        <GridSplitter x:Name="MainHorizontalSplitter" Grid.Column="0" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Visibility="Collapsed" Cursor="SizeNS"/>

                        <!-- ================================================= -->
                        <!-- RIGHT PANE: Qwen-Coder-Sec Assistant              -->
                        <!-- ================================================= -->
                        <Border x:Name="RightWorkstationPane"
                                Grid.Column="2" Grid.Row="0"
                                Background="{StaticResource BrushBgPane}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/> <!-- Assistant Header -->
                                    <RowDefinition Height="*"/>  <!-- Conversation Stream -->
                                    <RowDefinition Height="52"/> <!-- Input Bar -->
                                </Grid.RowDefinitions>

                                <!-- Assistant Header -->
                                <Border Grid.Row="0" Background="{StaticResource BrushBgSectionHeader}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource BrushBgPane}" BorderBrush="{StaticResource BrushAccentBlue}" BorderThickness="0,2,1,0" Padding="12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource BrushAccentBlue}" Margin="0,0,7,0"/>
                                                <TextBlock Text="Qwen-Coder-Sec Assistant" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Button Content="Audit Current Code" Style="{StaticResource ToolbarMiniBtn}" Click="BtnNavAudit_Click"/>
                                            <Button Content="Patch Vulnerability" Style="{StaticResource ToolbarMiniBtn}" Click="BtnApplyPatch_Click"/>
                                            <Button Content="Clear" Style="{StaticResource ToolbarMiniBtn}" Click="BtnClearChat_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Conversation Stream -->
                                <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
                                    <StackPanel x:Name="ChatContainer"/>
                                </ScrollViewer>

                                <!-- Bottom Prompt Input Bar -->
                                <Border Grid.Row="2" Background="#0b0e14" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="10,8">
                                    <Border Background="#11161e" BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1" CornerRadius="4" Padding="10,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="TxtPrompt"
                                                     Grid.Column="0"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource BrushTextPrimary}"
                                                     CaretBrush="{StaticResource BrushAccentBlue}"
                                                     BorderThickness="0"
                                                     FontFamily="Segoe UI"
                                                     FontSize="12.5"
                                                     VerticalContentAlignment="Center"
                                                     KeyDown="TxtPrompt_KeyDown"
                                                     Text="Ask Qwen-Coder-Sec about the active file or security vulnerabilities..."
                                                     GotFocus="TxtPrompt_GotFocus"
                                                     LostFocus="TxtPrompt_LostFocus"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Template" Style="{StaticResource ToolbarMiniBtn}" Click="BtnTemplate_Click" ToolTip="Insert Security Audit Prompt"/>
                                                <Button Content="Send ⏎" Style="{StaticResource ToolbarMiniBtn}" Foreground="{StaticResource BrushAccentBlue}" FontWeight="SemiBold" Click="BtnSend_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========================================================= -->
                <!-- ROW 2: Real-Time Hardware & System Telemetry Bar          -->
                <!-- ========================================================= -->
                <Border Grid.Row="2"
                        Background="{StaticResource BrushBgHeader}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,6,6">
                    <Grid Margin="14,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Real Hardware Telemetry Items -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrushAccentSage}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <TextBlock Text="MODEL: " FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTelemetryModel" Text="Qwen2.5-Coder-7B" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>

                            <TextBlock Text="   ·   " FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>

                            <TextBlock Text="GPU VRAM: " FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTelemetryVram" Text="Polling RTX 3050..." FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>

                            <TextBlock Text="   ·   " FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>

                            <TextBlock Text="GPU TEMP: " FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTelemetryTemp" Text="--°C" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>

                            <StackPanel x:Name="TelemetryExtraGroup" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="   ·   " FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="SYS RAM: " FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTelemetryRam" Text="-- / 32 GB" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>

                                <TextBlock Text="   ·   " FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="SANDBOX: " FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="ISOLATED" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource BrushAccentSage}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Status Indicator -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtGitBranchStatus" Text="⑂ feat/native-engine-and-automations" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="LOCAL AIR-GAP" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentSage}" VerticalAlignment="Center"/>
                            <TextBlock Text=" ◢" FontFamily="Consolas" FontSize="11" Foreground="#3b4654" VerticalAlignment="Bottom" Margin="8,0,-10,2" ToolTip="Drag any corner or edge to resize"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 8-Direction Native Edge & Corner Resize Handles -->
        <Thumb Height="6" VerticalAlignment="Top" Margin="10,0" Cursor="SizeNS" Opacity="0" PreviewMouseLeftButtonDown="ResizeTop_MouseDown"/>
        <Thumb Height="6" VerticalAlignment="Bottom" Margin="10,0" Cursor="SizeNS" Opacity="0" PreviewMouseLeftButtonDown="ResizeBottom_MouseDown"/>
        <Thumb Width="6" HorizontalAlignment="Left" Margin="0,10" Cursor="SizeWE" Opacity="0" PreviewMouseLeftButtonDown="ResizeLeft_MouseDown"/>
        <Thumb Width="6" HorizontalAlignment="Right" Margin="0,10" Cursor="SizeWE" Opacity="0" PreviewMouseLeftButtonDown="ResizeRight_MouseDown"/>

        <Thumb Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Opacity="0" PreviewMouseLeftButtonDown="ResizeTopLeft_MouseDown"/>
        <Thumb Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Opacity="0" PreviewMouseLeftButtonDown="ResizeTopRight_MouseDown"/>
        <Thumb Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Opacity="0" PreviewMouseLeftButtonDown="ResizeBottomLeft_MouseDown"/>
        <Thumb Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0" PreviewMouseLeftButtonDown="ResizeBottomRight_MouseDown"/>
    </Grid>
</Window>
